<diagram dimensions="(600,300)" margins="5" xmlns="https://prefigure.org">
  <definition>n=10</definition>
  <coordinates bbox="(-0.5,-0.5,n+0.5,2)">
    <axes decorations="no"/>
    <line endpoints="((0,0.9),(n+0.5,0.9))" stroke="blue"/>
    <label anchor="(0,0.9)" alignment="southwest"><m>L</m></label>
    <line endpoints="((0,1),(n+0.5,1))" stroke="blue"/>
    <label anchor="(0,1)" alignment="northwest"><m>U</m></label>
    <repeat parameter="k=1..n">
      <point p="(2*k,1+1/(2*k))"><m>u_${k}</m></point>
      <point p="(2*k-1,0.9-1/(2*k-1))" alignment="southeast"><m>l_${k}</m></point>
    </repeat>
  </coordinates>
</diagram>