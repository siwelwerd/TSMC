  <activity>
    <introduction>
      <p>
        Determine if each of the following series converge or diverge. If they converge, find their limit.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          <m>\displaystyle \sum _{n=1} ^\infty \left(\dfrac{2}{3}\right)^n</m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m>\displaystyle \sum _{n=1} ^\infty \dfrac{4^n}{3^n}</m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m>\displaystyle \sum _{n=1} ^\infty -\dfrac{3^n}{5^n}</m>
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <m>\displaystyle \sum _{n=1} ^\infty \dfrac{(-2)^n}{7^n}</m>
        </p>
      </statement>
    </task>
  </activity>

  <p>Lets now return to two series we examined previously.</p>
  <activity>
    <introduction>
      <p>The series <m>\displaystyle \sum _{n=1} ^\infty \dfrac{1}{n}</m>
      is called the <term>harmonic series</term>.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          Compute the first 10 terms (partial sums) of this series.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Compute the first 100 terms (partial sums) of this series.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Compute the first 1000 terms (partial sums) of this series.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Formulate a conjecture about whether this series converges or diverges.
        </p>
      </statement>
    </task>
  </activity>

  <theorem xml:id="thm-harmonic-series">
    <statement>
      <p>
        The harmonic series <m>\displaystyle \sum _{n=1} ^\infty \dfrac{1}{n}</m> converges/diverges.
      </p>
    </statement>
    <proof>
      <p>
        
      </p>
    </proof>
  </theorem>

  <activity>
    <introduction>
      Now consider the series <m>\displaystyle \sum _{n=1} ^\infty \dfrac{1}{n^2}</m>.
    </introduction>
    <task>
      <statement>
        <p>
          Compute the first 10 terms (partial sums) of this series.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Compute the first 100 terms (partial sums) of this series.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Compute the first 1000 terms (partial sums) of this series.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Formulate a conjecture about whether this series converges or diverges.
        </p>
      </statement>
    </task>
  </activity>

  <theorem xml:id="thm-p2-series">
    <statement>
      <p>
        The series <m>\displaystyle \sum _{n=1} ^\infty \dfrac{1}{n^2}</m> converges/diverges.
      </p>
    </statement>
    <proof>
      <p>
        
      </p>
    </proof>
  </theorem>

  <definition>
    <statement>
      <p>
        A <term><m>p</m>-series</term> is a series of the form <m>\displaystyle \sum _{n=1} ^\infty \dfrac{1}{n^p}</m>.
      </p>
    </statement>
  </definition>

  <theorem xml:id="thm-p-series">
    <statement>
      <p>
        A <m>p</m>-series of the form <m>\displaystyle \sum _{n=1} ^\infty \dfrac{1}{n^p}</m>
        converges for <m>p \gt 1</m> and diverges for <m>p \leq 1</m>.
      </p>
    </statement>
  </theorem>

  

</section>