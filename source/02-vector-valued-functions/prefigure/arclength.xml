<diagram dimensions="(600,300)" margins="5" xmlns="https://prefigure.org">
  <definition>alignments = ["northwest","northwest","northwest","northwest","north","northeast","northeast","east","southeast"]</definition>
  <definition>t = [0,0.5,1,1.5,2,2.5,3,3.5,4]</definition>
  <definition>r(t)=(-(t^2/15+2)*cos(t),(1.5-t/12)*sin(t))</definition>
  <coordinates bbox="(-3,-1.2,3.2,2)" aspect-ratio="1">
    <parametric-curve function="r" domain="(0,4)"/>
    <repeat parameter="i=0..8">
      <point p="r(t[i])" stroke="red" thickness="2" alignment="alignments[i]"><m>\vec{r}(t_${i})</m></point>
      <vector v="r(t[i+1])-r(t[i])" tail="r(t[i])" stroke="red" thickness="3"/>
    </repeat>
  </coordinates>
</diagram>
