<graph xmin="-1.5" xmax="1.5" ymin="-1.5" ymax="1.5"
       displayXAxisTicks="false" displayYAxisTicks="false">
    <shortDescription>
        A plot of <m>\langle \cos(t), \sin(t)\rangle</m>
    </shortDescription>
    
    <function name="f" variables="t">
      (cos(t^3-t), sin(t^3-t))
    </function>
      <vector styleNumber="2" draggable="false">$$f($a)</vector>
</graph>

<slider name="a" from="-2" to="2" step="0.01" 
        width="500" initialValue="0">
  <label><m>t</m></label>
</slider> 


