    <statement>
      <p>
        A geometric series <m>\displaystyle \sum _{n=1} ^\infty r^n</m> diverges
        when ??? and converges to ??? when ???
      </p>
    </statement>
    <proof>
      <p>
        
      </p>
    </proof>
