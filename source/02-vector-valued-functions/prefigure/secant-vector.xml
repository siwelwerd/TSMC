<diagram dimensions="(300,300)" margins="5" xmlns="https://prefigure.org">
  <definition>a = 0.5</definition>
  <definition>b = 1</definition>
  <definition>r(t)=(t^3-2*t,2*t^2)</definition>
  <coordinates bbox="(-2,-1,2,4)">
    <grid-axes />
    <parametric-curve function="r" domain="(-2,2)"/>
    <vector v="r(a)" stroke="red" thickness="2" alignment="west" ><m>\vec{r}(${a})</m></vector>
    <vector v="r(b)" stroke="red" thickness="2" alignment="west"  ><m>\vec{r}(${b})</m></vector>
    <vector v="r(b)-r(a)" tail="r(a)" stroke="green" thickness="2"></vector>
  </coordinates>
</diagram>